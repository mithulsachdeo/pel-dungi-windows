{
  "name": "pel-dungi-windows",
  "productName": "Pel Dungi",
  "version": "1.0.0",
  "description": "Windows tray port of the Pel Dungi menu-bar app",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "make-icon": "node tools/make-ico.js \"C:/Users/Admin/Downloads/PelDungi/Pel Dungi.app/Contents/Resources/AppIcon.icns\" assets/app.ico",
    "package": "electron-packager . \"Pel Dungi\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/app.ico --win32metadata.ProductName=\"Pel Dungi\" --win32metadata.FileDescription=\"Pel Dungi\" --ignore=^/dist --ignore=^/verification --ignore=^/tools --ignore=^/README.md --ignore=\"^/node_modules/koffi/build/koffi/(?!win32_x64)\" --ignore=\"^/node_modules/koffi/(src|vendor|doc)\" --asar.unpack=**/node_modules/koffi/**"
  },
  "dependencies": {
    "koffi": "2.16.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "electron": "33.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "koffi@2.16.4": true
  }
}
